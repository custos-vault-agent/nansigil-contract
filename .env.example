RPC_URL=http://127.0.0.1:8545
# Anvil default account #0 (local only). Upgrade authority, and attestor unless overridden.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Address that signs payloads (custos-attestation's ATTESTOR_PRIVATE_KEY). Defaults to deployer.
#ATTESTOR_ADDRESS=
# Where addresses are written. Use a separate file per network.
#DEPLOYMENT_FILE=deployments/anvil.json

# make verify — backend forge verify-contract talks to: sourcify (default, no
# key), etherscan, blockscout, or custom. URL and key rule come from the
# explorer's docs.
#VERIFIER=sourcify
#VERIFIER_URL=
#VERIFIER_API_KEY=
# Only when a role moved after the deployment: the constructor recorded what
# `initialize` received, not what the contract holds today.
#INIT_AUTHORITY=
#INIT_ATTESTOR=
